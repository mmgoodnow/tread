TREAD_BIND_ADDR=0.0.0.0:8080
TREAD_DATABASE_URL=sqlite://data/tread.db?mode=rwc
TREAD_POLL_INTERVAL_SECONDS=60

# Overseerr API polling is the authoritative request source for the narrow slice.
TREAD_OVERSEERR__ENABLED=false
TREAD_OVERSEERR__BASE_URL=http://overseerr:5055/
TREAD_OVERSEERR__API_KEY=change-me

# Prefer Tautulli for Plex recently-added availability events.
TREAD_TAUTULLI__ENABLED=false
TREAD_TAUTULLI__BASE_URL=http://tautulli:8181/
TREAD_TAUTULLI__API_KEY=change-me

# Reserved for the qBittorrent poller milestone.
TREAD_QBITTORRENT__ENABLED=false
TREAD_QBITTORRENT__BASE_URL=http://qbittorrent:8080/
TREAD_QBITTORRENT__USERNAME=admin
TREAD_QBITTORRENT__PASSWORD=adminadmin
